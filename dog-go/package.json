{
  "name": "dog-go",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "npx serve out",
    "lint": "next lint",
    "cap:sync": "next build && npx cap sync android",
    "android:apk": "next build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "icons": "node scripts/make-icons.mjs && npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.2",
    "@capacitor/android": "^7.6.11",
    "@capacitor/core": "^7.6.11",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@react-three/fiber": "^9.8.2",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.11",
    "@types/leaflet": "1.9",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4",
    "typescript": "^5.9.3"
  }
}
